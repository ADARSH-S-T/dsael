# LabFlow Environment Configuration

# Server
PORT=5001
NODE_ENV=development

# Supabase Credentials (Paste your project URL and keys here)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS Notification Provider (Twilio Example)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Notification Provider (Resend Example)
RESEND_API_KEY=
FROM_EMAIL=notifications@labflow.health

# JWT Secret (for session management)
JWT_SECRET=labflow_super_secret_enterprise_jwt_key_2026
