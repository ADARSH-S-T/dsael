# MedLabFlow Environment Configuration
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (auto | mongo | json)
DB_MODE=auto
MONGO_URI=mongodb://localhost:27017/medlab_db
DB_NAME=medlab_db

# Scheduler Engine ('python' or 'c')
SCHEDULER_ENGINE=python
C_ENGINE_LIB_PATH=c_engine/scheduler_core.dll

# Aging & Simulation Flags
AGING_ENABLED=false
AGING_MINUTES_ROUTINE_TO_URGENT=30
AGING_MINUTES_URGENT_TO_STAT=15
AUTO_DISPATCH=false
DEMO_SIMULATION=false

